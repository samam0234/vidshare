PORT=4000
NODE_ENV=development
# 비워 두면 localhost + 사설망(192.168/10/172.16-31) 프론트를 허용합니다.
CORS_ORIGIN=
# 비우면 BackendServer/data/vidshare.sqlite
SQLITE_PATH=
# 챗봇 (SpaceXAI / xAI). Locals는 키가 없거나 locals 모델이 없으면 로컬 무료 응답.
XAI_API_KEY=
CHAT_MODEL_LOCALS=locals
CHAT_MODEL_VIDE=grok-4.3
CHAT_MODEL_SHAPE=grok-4.6
