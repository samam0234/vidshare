PORT=4000
NODE_ENV=development

# ── PostgreSQL ────────────────────────────────────────────────
# 로컬: 내 PC 의 Postgres 16 (데이터는 D 드라이브, deploy/windows/setup-postgres-d.ps1 참고)
# 운영: Oracle VM 의 Postgres (127.0.0.1), deploy/oracle/backend.env.example 참고
DATABASE_URL=postgres://vidshare:CHANGE_ME@localhost:5432/vidshare
# npm test 전용 DB. 테스트는 이 DB 안에 파일마다 임시 스키마를 만들고 지운다.
DATABASE_URL_TEST=postgres://vidshare:CHANGE_ME@localhost:5432/vidshare_test
# 커넥션 풀 크기 (기본 10)
DB_POOL_MAX=10

# 업로드 저장 폴더. 비우면 BackendServer/uploads
# 로컬 권장: D:\vidshare-data\uploads   운영: /mnt/vidshare-data/uploads
UPLOADS_PATH=

# ── 쿠키 · CORS ───────────────────────────────────────────────
# 프로덕션은 반드시 프론트 오리진을 명시. 개발에서 비우면 사설망을 허용.
# CORS_ORIGIN=https://app.example.com,https://console.example.com
CORS_ORIGIN=
# 같은 등록 도메인의 서브도메인끼리 쿠키를 공유할 때 (앞에 점).
# COOKIE_DOMAIN=.example.com
COOKIE_DOMAIN=
# lax | strict | none  (none 은 HTTPS 필수)
COOKIE_SAMESITE=lax
# 앞단 리버스 프록시(Caddy) 홉 수. 로컬 0, Oracle VM 1
TRUST_PROXY=0

# ── 챗봇 LLM (LangChain) ──────────────────────────────────────
# Locals·Vide는 Gemini, Shape는 Groq(Kimi)를 씁니다.
# Gemini 키: https://aistudio.google.com/apikey
GOOGLE_API_KEY=
# Groq 키: https://console.groq.com/keys
GROQ_API_KEY=
CHAT_MODEL_LOCALS=gemini-3.1-flash-lite
CHAT_MODEL_VIDE=gemini-3.6-flash
CHAT_MODEL_SHAPE=openai/gpt-oss-120b
# 모델 호출 하나를 기다려 줄 상한(ms). 기본 45000.
# 이게 없으면 업스트림이 멎었을 때 OS TCP 타임아웃까지 매달리다 ETIMEDOUT 이 뜬다.
CHAT_TIMEOUT_MS=45000

# ── SQLite 이관 (1회용) ───────────────────────────────────────
# npm run db:import-sqlite 가 읽을 예전 SQLite 파일. 비우면 data/vidshare.sqlite
# SQLITE_PATH=
