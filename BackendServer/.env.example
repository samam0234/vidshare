PORT=4000
NODE_ENV=development
# 비워 두면 localhost + 사설망(192.168/10/172.16-31) 프론트를 허용합니다.
CORS_ORIGIN=
# 비우면 BackendServer/data/vidshare.sqlite
SQLITE_PATH=
# 챗봇 LLM (LangChain). https://console.x.ai 에서 키를 만들어 넣습니다. 비워 두면 로컬 Grok 로그인을 씁니다.
XAI_API_KEY=
CHAT_MODEL_LOCALS=grok-4.3
CHAT_MODEL_VIDE=grok-4.5
CHAT_MODEL_SHAPE=grok-4.6
