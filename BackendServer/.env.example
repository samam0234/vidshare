PORT=4000
NODE_ENV=development
# 비워 두면 localhost + 사설망(192.168/10/172.16-31) 프론트를 허용합니다.
CORS_ORIGIN=
# 비우면 BackendServer/data/vidshare.sqlite
SQLITE_PATH=
# 비우면 BackendServer/uploads
UPLOADS_PATH=
# 챗봇 LLM (LangChain). Locals·Vide는 Gemini, Shape는 Groq(Kimi)를 씁니다.
# Gemini 키: https://aistudio.google.com/apikey
GOOGLE_API_KEY=
# Groq 키: https://console.groq.com/keys
GROQ_API_KEY=
CHAT_MODEL_LOCALS=gemini-3.1-flash-lite
CHAT_MODEL_VIDE=gemini-3.6-flash
CHAT_MODEL_SHAPE=openai/gpt-oss-120b
# 모델 호출 하나를 기다려 줄 상한(ms). 기본 45000.
# 이게 없으면 업스트림이 멎었을 때 OS TCP 타임아웃까지 매달리다 ETIMEDOUT 이 뜬다.
CHAT_TIMEOUT_MS=45000
