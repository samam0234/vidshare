# /etc/vidshare/backend.env  (권한 600, 소유 vidshare)
# setup-vm.sh 가 이 견본으로 만든다. 저장소에 실제 값을 커밋하지 않는다.

PORT=4000
NODE_ENV=production

DATABASE_URL=postgres://vidshare:CHANGE_ME_DB_PASSWORD@127.0.0.1:5432/vidshare
DB_POOL_MAX=10
UPLOADS_PATH=/mnt/vidshare-data/uploads

# 프론트 두 곳만 허용. 프론트·콘솔·API 가 같은 등록 도메인 아래여야 쿠키가 실린다.
CORS_ORIGIN=https://app.example.com,https://console.example.com
COOKIE_DOMAIN=.example.com
COOKIE_SAMESITE=lax
# Caddy 한 단계 뒤
TRUST_PROXY=1

GOOGLE_API_KEY=
GROQ_API_KEY=
CHAT_MODEL_LOCALS=gemini-3.1-flash-lite
CHAT_MODEL_VIDE=gemini-3.6-flash
CHAT_MODEL_SHAPE=openai/gpt-oss-120b
CHAT_TIMEOUT_MS=45000
